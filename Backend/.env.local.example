# Local development without Supabase: embedded PostgreSQL (PGlite) stored on disk.
# Copy to Backend/.env.local, then: npm run db:local:setup && npm run dev:local
PORT=4000
CORS_ORIGIN=http://localhost:5173
DB_DRIVER=pglite
PGLITE_DATA_DIR=./.data/pglite
# Sign-in still uses your Supabase project (local mode only replaces the database)
SUPABASE_URL=https://your-project-ref.supabase.co
