{
  "name": "unitworks-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "dev:local": "node --env-file-if-exists=.env.local --watch src/server.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:audit": "node --env-file-if-exists=.env scripts/data-audit.js",
    "db:snapshot": "node --env-file-if-exists=.env scripts/data-snapshot.js",
    "db:local:setup": "node --env-file-if-exists=.env.local scripts/migrate.js && node --env-file-if-exists=.env.local scripts/seed.js",
    "seed:generate": "node scripts/generate-seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\"",
    "bench:algorithms": "node scripts/benchmark-algorithms.js",
    "users": "node --env-file-if-exists=.env scripts/users.js",
    "users:local": "node --env-file-if-exists=.env.local scripts/users.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^5.10.0",
    "pg": "^8.13.1"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  }
}
