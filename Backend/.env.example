# Copy to Backend/.env and fill in. Never commit .env or expose these values to the frontend.
PORT=4000
# Comma-separated list of allowed browser origins (the Vite dev server by default)
CORS_ORIGIN=http://localhost:5173

# postgres = Supabase PostgreSQL (default) · pglite = embedded local database for development only
DB_DRIVER=postgres
# Supabase → Project Settings → Database → Connection string (URI). Use the session pooler
# (port 5432) or the direct connection. Contains your database password: backend only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-your-region.pooler.supabase.com:5432/postgres
# Supabase requires TLS
DATABASE_SSL=true

# Supabase project URL (Project Settings → API). Access tokens from the frontend are verified against
# this project's public signing keys at <SUPABASE_URL>/auth/v1/.well-known/jwks.json — no secret needed.
SUPABASE_URL=https://your-project-ref.supabase.co
